{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brokie.example/schemas/scout-packet.v0.2.schema.json",
  "title": "ScoutPacket v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "seed", "subject", "collection", "pages"],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "packet_id": { "$ref": "#/$defs/packetId" },
    "seed": { "$ref": "#/$defs/seed" },
    "subject": { "$ref": "#/$defs/subject" },
    "collection": { "$ref": "#/$defs/collection" },
    "pages": {
      "type": "array",
      "items": { "$ref": "#/$defs/page" },
      "maxItems": 2
    }
  },
  "$defs": {
    "packetId": {
      "type": "string",
      "pattern": "^scoutpkt_sha256_[0-9a-f]{64}$"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^art_sha256_[0-9a-f]{64}$"
    },
    "linkId": {
      "type": "string",
      "pattern": "^link_sha256_[0-9a-f]{64}$"
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator", "revision"],
      "properties": {
        "kind": { "enum": ["git", "web"] },
        "locator": { "type": "string", "minLength": 1 },
        "revision": { "type": ["string", "null"] }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_label", "primary_url"],
      "properties": {
        "source_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\r\\n]*$"
        },
        "primary_url": { "type": "string", "pattern": "^https?://" }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "artifact_id", "start_byte", "end_byte", "text"],
      "properties": {
        "locator": { "type": "string", "minLength": 1 },
        "artifact_id": { "$ref": "#/$defs/artifactId" },
        "start_byte": { "type": "integer", "minimum": 0 },
        "end_byte": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["link_id", "source_artifact_id", "start_byte", "end_byte", "label", "raw_destination", "resolved_destination", "source_depth"],
      "properties": {
        "link_id": { "$ref": "#/$defs/linkId" },
        "source_artifact_id": { "$ref": "#/$defs/artifactId" },
        "start_byte": { "type": "integer", "minimum": 0 },
        "end_byte": { "type": "integer", "minimum": 1 },
        "label": { "type": "string", "maxLength": 500 },
        "raw_destination": { "type": "string", "maxLength": 4000 },
        "resolved_destination": { "type": "string", "pattern": "^https?://" },
        "source_depth": { "type": "integer", "minimum": 0, "maximum": 1 }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "requested_url", "final_url", "depth", "status", "content_reasons", "raw_artifact_id", "readable_artifact_id", "transformation", "parent_url", "originating_link", "http_status", "failure"],
      "properties": {
        "role": { "enum": ["listed_page", "evidence_page"] },
        "requested_url": { "type": "string", "minLength": 1 },
        "final_url": { "type": "string", "minLength": 1 },
        "depth": { "type": "integer", "minimum": 1, "maximum": 2 },
        "status": { "enum": ["acquired", "blocked", "failed"] },
        "content_reasons": {
          "type": "array",
          "items": { "enum": ["browser_required", "readable_content_sparse"] },
          "uniqueItems": true
        },
        "raw_artifact_id": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifactId" }]
        },
        "readable_artifact_id": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifactId" }]
        },
        "transformation": { "type": ["string", "null"] },
        "parent_url": { "type": "string", "minLength": 1 },
        "originating_link": { "$ref": "#/$defs/link" },
        "http_status": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
        "failure": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/failure" }]
        }
      }
    }
  }
}
